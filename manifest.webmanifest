{
  "name": "Mindmap",
  "short_name": "Mindmap",
  "description": "Mindmaps erstellen und bearbeiten, kompatibel mit der Mac-App.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F9F8F5",
  "theme_color": "#FFFFFF",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-mindmap": [".mindmap"] } }
  ]
}
